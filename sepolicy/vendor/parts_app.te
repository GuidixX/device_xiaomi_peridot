allow parts_app sysfs_sndctrl:file rw_file_perms;
allow parts_app vendor_sysfs_graphics:dir search;
allow parts_app vendor_sysfs_graphics:file rw_file_perms;
allow parts_app vendor_sysfs_kgsl:dir search;
allow parts_app vendor_sysfs_kgsl:{ file lnk_file } rw_file_perms;
allow parts_app vendor_hal_displayfeature_xiaomi_service:binder { call transfer };
allow parts_app vendor_hal_displayfeature_xiaomi_default:binder { call transfer };
allow parts_app vendor_sysfs_battery_supply:dir search;
allow parts_app vendor_sysfs_battery_supply:file rw_file_perms;
allow parts_app vendor_sysfs_kgsl_gpuclk:file { read open getattr };
allow parts_app vendor_sysfs_kgsl_gpuclk:file { read open getattr };
allow parts_app vendor_sysfs_power_supply:file w_file_perms;
allow parts_app vendor_sysfs_displayfeature:dir { search read open getattr };
allow parts_app vendor_sysfs_displayfeature:file { read open getattr };
binder_call(parts_app, vendor_hal_displayfeature_xiaomi_default)
binder_call(parts_app, vendor_hal_qspmhal_default)
