type thermal_charging_service, domain;
type thermal_charging_service_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(thermal_charging_service)

# Allow access to battery power supply sysfs
allow thermal_charging_service vendor_sysfs_power_supply:dir r_dir_perms;
allow thermal_charging_service vendor_sysfs_power_supply:file rw_file_perms;
allow thermal_charging_service vendor_sysfs_battery_supply:dir search;
allow thermal_charging_service vendor_sysfs_battery_supply:file rw_file_perms;

# Specific permissions for battery control files
allow thermal_charging_service sysfs_power_supply:dir search;
allow thermal_charging_service sysfs_power_supply:file rw_file_perms;
allow thermal_charging_service sysfs_battery_supply:dir search;
allow thermal_charging_service sysfs_battery_supply:file rw_file_perms;
allow thermal_charging_service sysfs_fastcharge:dir r_dir_perms;
allow thermal_charging_service sysfs_fastcharge:file rw_file_perms;

# Allow access to kernel message buffer for logging
allow thermal_charging_service kmsg_device:chr_file write;

# Allow executing system commands
allow thermal_charging_service shell_exec:file { execute execute_no_trans };
allow thermal_charging_service self:netlink_kobject_uevent_socket { create bind read setopt getopt };

binder_call(thermal_charging_service, default_android_hwservice)

set_prop(thermal_charging_service, vendor_thermal_prop)

allow thermal_charging_service property_socket:sock_file { write };
allow thermal_charging_service proc_stat:file { read open getattr };
allow thermal_charging_service init:unix_stream_socket connectto;
